{
  "info": {
    "name": "CP5 - Mercado Express e Banco Tranquilo",
    "description": "Testes da integração Mercado Express → RabbitMQ → Banco Tranquilo → e-mail, com Spring Security.\nA collection usa HTTP Basic com o usuário ADMIN (variáveis adminEmail/adminSenha). As chamadas diretas ao Banco Tranquilo enviam o cabeçalho X-API-KEY. Ajuste emailCliente para um e-mail seu e rode tudo pelo Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "bancoUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "emailCliente",
      "value": "seu-email-de-teste@exemplo.com"
    },
    {
      "key": "pedidoId",
      "value": "1"
    },
    {
      "key": "produtoId",
      "value": "1"
    },
    {
      "key": "adminEmail",
      "value": "admin@mercadoexpress.com"
    },
    {
      "key": "adminSenha",
      "value": "Admin@2026"
    },
    {
      "key": "clienteEmail",
      "value": "cliente@mercadoexpress.com"
    },
    {
      "key": "clienteSenha",
      "value": "Cliente@2026"
    },
    {
      "key": "bancoApiKey",
      "value": "bt-dev-chave-local-123"
    }
  ],
  "item": [
    {
      "name": "0. Segurança (Spring Security)",
      "item": [
