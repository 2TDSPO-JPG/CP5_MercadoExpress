# Copie para .env (na VM) e troque TODOS os valores. Nunca suba o .env para o GitHub.

# PostgreSQL
POSTGRES_DB=mercado_express
POSTGRES_USER=mercado
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# RabbitMQ (mesmo usuário para o painel e para a aplicação)
RABBITMQ_USERNAME=mercado
RABBITMQ_PASSWORD=troque-por-uma-senha-forte
# Link do botão "RabbitMQ" no site: http://<ip-ou-dns-da-vm>:15672
RABBITMQ_DASHBOARD_URL=http://SEU-IP-OU-DNS:15672

# Chave da API do Banco Tranquilo (mesma nos dois serviços)
BANCO_API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Gmail SMTP (use uma SENHA DE APP do Google)
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=sua-senha-de-app
MAIL_FROM=seuemail@gmail.com

# Usuários iniciais do sistema
ADMIN_EMAIL=admin@mercadoexpress.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
CLIENTE_EMAIL=cliente@mercadoexpress.com
CLIENTE_PASSWORD=troque-por-uma-senha-forte
